# ==============================================================================
# FreelanceHub Backend Environment Configuration Template
# DO NOT store real credentials in this file. Copy to backend/.env and update.
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=replace-with-a-50-character-secure-random-secret-key-for-production
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Set USE_SQLITE=True for local development (no PostgreSQL required)
# Set USE_SQLITE=False for production with PostgreSQL
USE_SQLITE=True

# PostgreSQL Database Configuration (used when USE_SQLITE=False)
DB_NAME=freelancehub_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password
DB_HOST=localhost
DB_PORT=5432

# CORS (Cross-Origin Resource Sharing) Allowed Origins for Frontend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SimpleJWT Authentication Configuration
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# AI Assessment Provider Settings (mock, gemini, or openai)
AI_API_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
